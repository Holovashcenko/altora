NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Swagger UI at /api/docs. Defaults to on outside production.
SWAGGER_ENABLED=true

# PostgreSQL (see infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql://altora:altora@localhost:5433/altora

# Auth — replace with your own secret (min 32 chars): openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars
JWT_EXPIRES_IN=1d

REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=altora
MINIO_SECRET_KEY=altora-secret
