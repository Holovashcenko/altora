{
  "extends": "@altora/tsconfig/nest-app.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    // The e2e suite lives outside `src`, so the editor/typecheck project spans
    // the whole package. `tsconfig.build.json` narrows it back for emit.
    "rootDir": "."
  },
  "include": ["src/**/*", "test/**/*"]
}
